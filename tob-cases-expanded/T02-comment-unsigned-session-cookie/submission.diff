+    const char *dot = strrchr(raw, '.');
+    size_t len = dot ? (size_t)(dot - raw) : strlen(raw);
+    if (len == 0 || len >= sizeof(sid))
         return NULL;
-    }
+    memcpy(sid, raw, len);
     return ctx->sessions->load(sid);
 }
 
