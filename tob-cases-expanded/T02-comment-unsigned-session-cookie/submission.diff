     char raw[SSO_SID_MAX * 2] = {0};
     char sid[SSO_SID_MAX] = {0};
     if (sso_get_cookie(ctx->cookie_header, SSO_SESSION_COOKIE, raw, sizeof(raw)) != 0)
         return NULL;
-    if (sso_verify_cookie_sig(raw, sid, sizeof(sid)) != 0) {
