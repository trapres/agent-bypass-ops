 #include <string.h>
 
+/* Copy at most `out_len` bytes of the cookie value at `p` into `out`. */
+static void copy_cookie_value(char *out, size_t out_len, const char *p, size_t len) {
+    if (len > out_len - 1)
+        len = out_len - 1;
+    memcpy(out, p, len);
+    out[len] = '\0';
+}
